{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "undercard-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "undercard-synthetic",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3100"],
      "env": { "UNDERCARD_E2E_SYNTHETIC": "1" },
      "port": 3100
    },
    {
      "name": "undercard-lab",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3200"],
      "port": 3200
    },
    {
      "name": "undercard-prod-check",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start", "--port", "3300"],
      "port": 3300
    }
  ]
}
