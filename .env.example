# Copy to .env.local (never committed) and to Vercel's environment variables.

# Qloo hackathon key, from the Google form. It works only against the hackathon base URL.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Anthropic key for src/server/ai.ts. Keep it in .env.local and Vercel only:
# never export it in your shell, or Claude Code bills the API instead of your plan.
ANTHROPIC_API_KEY=

# Upstash Redis (free tier) for the Qloo response cache and AI rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for GET /api/health/deep, the deep health check (one Qloo search and one
# one-token Claude call); the route answers 404 while it is unset. The daily smoke workflow
# sends the same value from the HEALTH_TOKEN repository secret.
HEALTH_TOKEN=
